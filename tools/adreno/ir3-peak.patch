+/* IR3_PEAK=T (debug): log each new pressure record of at least T half-registers, with what is live there */
+static void
+peak_log(struct ra_spill_ctx *ctx, struct ir3_instruction *instr)
+{
+   static int thr = -2;
+   if (thr == -2) { const char *e = getenv("IR3_PEAK"); thr = e ? atoi(e) : -1; }
+   if (ctx->cur_pressure.full > ctx->blk_max) ctx->blk_max = ctx->cur_pressure.full;
+   if (thr < 0 || ctx->cur_pressure.full < (unsigned)thr || ctx->cur_pressure.full <= ctx->peak_seen) return;
+   ctx->peak_seen = ctx->cur_pressure.full;
+   mesa_logi("PEAK %u block %u instr %u", ctx->cur_pressure.full, instr->block->index, instr->serialno);
+   ir3_print_instr(instr);
+   rb_tree_foreach (struct ra_spill_interval, iv, &ctx->reg_ctx.intervals, interval.node) {
+      struct ir3_register *r = iv->interval.reg;
+      mesa_logi("LIVE size %u", reg_size(r));
+      ir3_print_instr(r->instr);
+   }
+   mesa_logi("PEAKEND");
+}

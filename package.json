{
  "name": "tidemote",
  "private": true,
  "type": "module",
  "description": "A sealed GPU biosphere: particle life, evolution and ecology on WebGPU",
  "license": "GPL-3.0-or-later",
  "author": "Tyler Hallada",
  "repository": {
    "type": "git",
    "url": "https://github.com/thallada/tidemote"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:site": "node build.mjs && cp dist/tidemote.html site/index.html",
    "sim": "node tools/sim.mjs",
    "compare": "node tools/compare.mjs",
    "test": "node --test",
    "gate": "tools/gpu-node.sh tools/ensemble.mjs --runs 32 --minutes 30 --n 32768 --jobs 4 --baseline balance/baseline-32k-30m.json",
    "text": "node tools/i18n/textlab.mjs",
    "text:extract": "node tools/i18n/extract.mjs",
    "text:review": "~/.local/bin/capped -m 600M node tools/i18n/review.mjs",
    "text:promote": "node tools/i18n/promote.mjs",
    "gate:farm": "node tools/farm.mjs --runs 32 --minutes 30 --n 32768 --baseline balance/baseline-32k-30m.json"
  },
  "dependencies": {
    "intl-messageformat": "^10.7.18",
    "pngjs": "^7.0.0",
    "webgpu": "^0.6.1"
  },
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "harper.js": "^3.0.0",
    "magic-string": "^1.4.5",
    "parse5": "^8.1.0",
    "playwright-core": "^1.63.0"
  }
}

// Cloudflare Workers static-assets deploy for tidemote.com (no Worker code: assets only).
// `npm run build:site` assembles ./site; Workers Builds runs it, then `npx wrangler deploy`.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "tidemote",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./site",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "tidemote.com", "custom_domain": true }
  ]
}
